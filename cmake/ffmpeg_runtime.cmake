include_guard(GLOBAL)

# Inspect PE headers without loading DLLs. Target architecture is detected by CMake's
# compiler checks; a renamed foreign-architecture runtime must fail configuration.
function(pip_validate_ffmpeg_pe file)
    file(SIZE "${file}" pip_size)
    if (pip_size LESS 64)
        message(FATAL_ERROR "FFmpeg runtime is not a PE image: ${file}")
    endif()
    file(READ "${file}" pip_magic OFFSET 0 LIMIT 2 HEX)
    file(READ "${file}" pip_pe_offset OFFSET 60 LIMIT 4 HEX)
    string(REGEX REPLACE "(..)(..)(..)(..)" "\\4\\3\\2\\1" pip_pe_offset "${pip_pe_offset}")
    math(EXPR pip_pe_offset "0x${pip_pe_offset}")
    math(EXPR pip_header_end "${pip_pe_offset} + 6")
    if (NOT pip_magic STREQUAL "4d5a" OR pip_header_end GREATER pip_size)
        message(FATAL_ERROR "FFmpeg runtime has an invalid PE header: ${file}")
    endif()
    file(READ "${file}" pip_header OFFSET ${pip_pe_offset} LIMIT 6 HEX)
    # Generator/compiler target identifiers take precedence over the host CPU, which
    # differs when an ARM64 Windows developer selects an x64 cross-compilation kit.
    string(TOLOWER "${CMAKE_GENERATOR_PLATFORM}" pip_platform)
    string(TOLOWER "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}" pip_compiler_architecture)
    if (pip_platform MATCHES "^arm64(,|$)" OR
            (NOT pip_platform AND pip_compiler_architecture STREQUAL "arm64") OR
            (NOT pip_platform AND NOT pip_compiler_architecture AND
                CMAKE_SYSTEM_PROCESSOR MATCHES "^(ARM64|arm64|aarch64)$"))
        set(pip_machine "64aa")
    elseif (CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(pip_machine "6486")
    else()
        set(pip_machine "4c01")
    endif()
    if (NOT pip_header STREQUAL "50450000${pip_machine}")
        message(FATAL_ERROR "FFmpeg runtime PE architecture does not match target: ${file}")
    endif()
endfunction()

# Read actual imports using the compiler's PE inspector. Tool failures/timeouts are fatal,
# preventing an empty dependency set from being mistaken for a self-contained runtime.
function(pip_ffmpeg_imports file output)
    if (PIP_FFMPEG_IMPORT_TOOL MATCHES "[Dd][Uu][Mm][Pp][Bb][Ii][Nn](\\.exe)?$")
        set(pip_arguments /nologo /dependents "${file}")
    else()
        set(pip_arguments -p "${file}")
        set(pip_pattern "DLL Name:[ \t]*[^\r\n]+")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C
        "${PIP_FFMPEG_IMPORT_TOOL}" ${pip_arguments}
        RESULT_VARIABLE pip_result OUTPUT_VARIABLE pip_imports ERROR_VARIABLE pip_error
        TIMEOUT 15)
    if (NOT pip_result STREQUAL "0")
        message(FATAL_ERROR "Cannot inspect FFmpeg imports: ${file}\n${pip_result}: ${pip_error}")
    endif()
    if (PIP_FFMPEG_IMPORT_TOOL MATCHES "[Dd][Uu][Mm][Pp][Bb][Ii][Nn](\\.exe)?$")
        # Consume individual normalized lines; a MATCHALL expression that owns both
        # surrounding newlines would skip alternating dependencies on LF output.
        string(REPLACE "\r" "" pip_imports "${pip_imports}")
        string(REPLACE "\n" ";" pip_lines "${pip_imports}")
        set(pip_matches "")
        foreach(pip_line IN LISTS pip_lines)
            string(STRIP "${pip_line}" pip_line)
            if (pip_line MATCHES "\\.[Dd][Ll][Ll]$")
                list(APPEND pip_matches "${pip_line}")
            endif()
        endforeach()
    else()
        string(REGEX MATCHALL "${pip_pattern}" pip_matches "${pip_imports}")
    endif()
    set(pip_names "")
    foreach(pip_match IN LISTS pip_matches)
        string(REGEX REPLACE "^DLL Name:[ \t]*" "" pip_name "${pip_match}")
        string(STRIP "${pip_name}" pip_name)
        string(TOLOWER "${pip_name}" pip_name)
        if (pip_name MATCHES "[/\\\\:;]")
            message(FATAL_ERROR "Unsafe PE import filename in ${file}: ${pip_name}")
        endif()
        list(APPEND pip_names "${pip_name}")
    endforeach()
    if (NOT pip_names)
        message(FATAL_ERROR "PE inspection returned no DLL imports: ${file}")
    endif()
    set(${output} "${pip_names}" PARENT_SCOPE)
endfunction()

# Collect FFmpeg 7's actual non-system import closure from one directory. The returned
# paths serve both POST_BUILD and install(FILES); no arbitrary PATH/cache fallback occurs.
function(pip_collect_ffmpeg_runtime directory output)
    if (NOT WIN32)
        message(FATAL_ERROR "pip_collect_ffmpeg_runtime requires a Windows target")
    endif()
    if (NOT IS_DIRECTORY "${directory}")
        message(FATAL_ERROR "FFmpeg runtime directory does not exist: ${directory}")
    endif()
    if (CMAKE_OBJDUMP AND EXISTS "${CMAKE_OBJDUMP}")
        set(PIP_FFMPEG_IMPORT_TOOL "${CMAKE_OBJDUMP}")
    else()
        get_filename_component(pip_compiler_directory "${CMAKE_CXX_COMPILER}" DIRECTORY)
        find_program(PIP_FFMPEG_IMPORT_TOOL NAMES dumpbin llvm-objdump objdump
            HINTS "${pip_compiler_directory}" NO_CACHE REQUIRED)
    endif()
    file(REAL_PATH "${directory}" pip_directory)
    file(GLOB pip_candidates "${pip_directory}/*.[dD][lL][lL]")
    set(pip_names "")
    foreach(pip_candidate IN LISTS pip_candidates)
        get_filename_component(pip_name "${pip_candidate}" NAME)
        string(TOLOWER "${pip_name}" pip_name)
        list(FIND pip_names "${pip_name}" pip_duplicate)
        if (NOT pip_duplicate EQUAL -1)
            message(FATAL_ERROR "Ambiguous FFmpeg DLL filename: ${pip_name} in ${directory}")
        endif()
        list(APPEND pip_names "${pip_name}")
    endforeach()
    set(pip_pending avcodec-61.dll avutil-59.dll swscale-8.dll)
    set(pip_seen "")
    set(pip_files "")
    set(pip_allowed_ffmpeg avcodec-61.dll avdevice-61.dll avfilter-10.dll avformat-61.dll
        avutil-59.dll postproc-58.dll swresample-5.dll swscale-8.dll)
    while(pip_pending)
        list(POP_FRONT pip_pending pip_name)
        list(FIND pip_seen "${pip_name}" pip_visited)
        if (NOT pip_visited EQUAL -1)
            continue()
        endif()
        list(APPEND pip_seen "${pip_name}")
        list(LENGTH pip_seen pip_count)
        if (pip_count GREATER 128)
            message(FATAL_ERROR "FFmpeg import closure exceeds 128 DLLs in ${directory}")
        endif()
        if (pip_name MATCHES "^(avcodec|avdevice|avfilter|avformat|avutil|postproc|swresample|swscale)-")
            list(FIND pip_allowed_ffmpeg "${pip_name}" pip_abi)
            if (pip_abi EQUAL -1)
                message(FATAL_ERROR "FFmpeg 7 runtime imports an incompatible ABI: ${pip_name}")
            endif()
        endif()
        list(FIND pip_names "${pip_name}" pip_index)
        if (pip_index EQUAL -1)
            message(FATAL_ERROR "FFmpeg runtime dependency missing from ${directory}: ${pip_name}")
        endif()
        list(GET pip_candidates ${pip_index} pip_file)
        pip_validate_ffmpeg_pe("${pip_file}")
        if (NOT CMAKE_SCRIPT_MODE_FILE)
            # Re-scan after an SDK replaces a same-named DLL with new imports; otherwise
            # a previous configure could leave POST_BUILD/install's closure incomplete.
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${pip_file}")
        endif()
        list(APPEND pip_files "${pip_file}")
        pip_ffmpeg_imports("${pip_file}" pip_imports)
        foreach(pip_import IN LISTS pip_imports)
            # Check FFmpeg imports even if the host happens to carry such a DLL in a
            # system directory. Runtime SDK files take precedence for all other imports.
            if (pip_import MATCHES "^(avcodec|avdevice|avfilter|avformat|avutil|postproc|swresample|swscale)-")
                list(FIND pip_allowed_ffmpeg "${pip_import}" pip_abi)
                if (pip_abi EQUAL -1)
                    message(FATAL_ERROR "FFmpeg 7 runtime imports an incompatible ABI: ${pip_import}")
                endif()
            endif()
            # API sets are virtual OS contracts, not distributable files.
            if (pip_import MATCHES "^(api-ms-win-|ext-ms-win-)")
                continue()
            endif()
            list(FIND pip_names "${pip_import}" pip_index)
            if (NOT pip_index EQUAL -1)
                list(APPEND pip_pending "${pip_import}")
                continue()
            endif()
            if (EXISTS "$ENV{SystemRoot}/System32/${pip_import}" AND
                    NOT pip_import MATCHES "^(avcodec|avdevice|avfilter|avformat|avutil|postproc|swresample|swscale)-")
                continue()
            endif()
            if (pip_index EQUAL -1)
                message(FATAL_ERROR "FFmpeg dependency missing: ${pip_name} -> ${pip_import}\n"
                    "All non-system DLLs must be supplied by ${directory}")
            endif()
        endforeach()
    endwhile()
    set(${output} "${pip_files}" PARENT_SCOPE)
    set(PIP_FFMPEG_RUNTIME_IMPORT_TOOL "${PIP_FFMPEG_IMPORT_TOOL}" PARENT_SCOPE)
endfunction()
